# Supabase project URL and publishable (anon) key. Both are browser-safe.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
# Turso HTTPS URL and database token: SERVER ONLY. Never prefix these with NEXT_PUBLIC_.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# Trusted public deployment origin (no trailing slash), for Supabase redirect URLs.
APP_ORIGIN=http://localhost:3000
# Optional: RATE_<ACTION>_MAX and RATE_<ACTION>_WINDOW_SECONDS (see README).

# Optional production rate overrides (positive integers; use Workers runtime variables):
# RATE_LOGIN_MAX=5
# RATE_LOGIN_WINDOW_SECONDS=3600
# RATE_THREAD_MAX=5
# RATE_REPLY_MAX=20
# RATE_SEARCH_MAX=30
# RATE_SEARCH_WINDOW_SECONDS=60
# Other actions: DUPLICATE, EDIT, REACTION, REPORT, BOOKMARK, AVATAR,
# NOTIFICATION, PROFILE, MODERATION, CATEGORY, VIEW (same suffixes).
# R2 binding AVATARS is set in wrangler.jsonc, not in .env.
